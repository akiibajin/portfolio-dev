<aside popover="manual" popover-open="true" id="news" class="popover-news" aria-label="Latest updates">
  <div
    class="relative top-0 p-px bg-gradient-to-r w-48 h-14 sm:w-60 sm:h-24 from-blue-500 bg-opacity-70 to-purple-500 overflow-hidden rounded-lg"
  >
    <swiper-container
      space-between={5}
      pagination="true"
      slides-per-view={1}
      autoplay={true}
      init="false"
      id="news-swiper"
      class="h-full w-full bg-black rounded-lg"
    >
      <swiper-slide
        lazy="true"
        class="flex overflow-hidden rounded-lg items-end justify-center h-full"
      >
        <img
          src="/slide%201.avif"
          alt="Marshall Law"
          loading="lazy"
          decoding="async"
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
        />
        <p
          class="text-pretty text-white font-thin text-xs md:text-sm absolute bottom-0 [text-shadow:0_0_3px_black]"
        >
          A new version of this portfolio is on the way
        </p>
      </swiper-slide>
      <swiper-slide
        lazy="true"
        class="flex items-end overflow-hidden rounded-lg justify-center h-full"
      >
        <img
          src="/slide%202.jpg"
          alt="Kazuya Mishima"
          loading="lazy"
          decoding="async"
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
        />
        <p
          class="text-pretty text-white font-thin text-xs md:text-sm absolute bottom-0 [text-shadow:0_0_3px_black]"
        >
          Latest updates from my projects
        </p>
      </swiper-slide>
      <swiper-slide
        lazy="true"
        class="flex items-end overflow-hidden rounded-lg justify-center h-full"
      >
        <img
          src="/slide%203.webp"
          alt="Jin Kazama"
          loading="lazy"
          decoding="async"
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
        />
        <p
          class="text-pretty text-white font-thin text-xs md:text-sm absolute bottom-0 [text-shadow:0_0_3px_black]"
        >
          Background art loads lazily to keep the first paint fast
        </p>
      </swiper-slide>
    </swiper-container>
  </div>
  <div
    id="pagination"
    class="absolute text-end h-4 lg:text-center transition-opacity w-full duration-300 transform translate-x-0 translate-y-0 z-10"
  >
  </div>
</aside>
<script>
  import { register, type SwiperContainer } from "swiper/element";
  import type { SwiperOptions } from "swiper/types";
  register();
  document.addEventListener("astro:page-load", () => {
    const swiperEl: SwiperContainer | null =
      document.querySelector("#news-swiper");
    if (swiperEl) {
      const options: SwiperOptions = {
        pagination: {
          clickable: false,
          el: "#pagination",
          bulletActiveClass: "bullet-active",
          bulletClass: "bullet",
        },
      };
      Object.assign(swiperEl, options);
      swiperEl.initialize();

      const popover = document.getElementById("news");
      if (window.innerWidth > 648 && popover) {
        popover.showPopover();
      }
    }
  });
</script>

<style>
  .popover-news:popover-open {
    scale: 1;
    transition: scale 0.2s ease-in-out;
    @starting-style {
      scale: 0;
    }
  }
  .popover-news {
    bottom: 8.5rem;
    right: 0.75rem;
    top: auto;
    left: auto;
    width: 12rem;
    height: 5.5rem;
    border-radius: 0.5rem;
    position: fixed;
    background-color: transparent;
    scale: 0;
    z-index: 1;
    transition:
      scale 0.15s ease-in-out,
      display 0.15s ease-in-out allow-discrete;
  }

  @media (width >= 64rem) {
    .popover-news {
      bottom: 7.5rem;
      right: 2.5rem;
      width: 15rem;
      height: 7.5rem;
    }
  }
</style>
