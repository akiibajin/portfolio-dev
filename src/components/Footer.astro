---
import Separator from "./Separator.astro";
import Settings from "./icons/Settings.astro";
import People from "./icons/People.astro";
import Linkedin from "./icons/Linkedin.astro";
import Folder from "./icons/Folder.astro";
import Bell from "./icons/Bell.astro";
import XboxA from "./icons/Xbox-A.astro";
import { profile } from "../global/constants";
---

<footer class="shrink-0 lg:w-full container mx-auto">
    <nav class="ml-4 mb-6" aria-label="Elsewhere">
        <ul class="flex flex-wrap gap-6 lg:gap-10">
            <li class="flex flex-col gap-1.5 justify-center text-xs opacity-50">
                <Settings className="mx-auto w-8" />
                Options
            </li>
            <li class="flex flex-col gap-1.5 justify-center text-xs opacity-50">
                <People className="mx-auto" />
                Community
            </li>
            <li>
                <a
                    class="flex flex-col gap-1.5 justify-center rounded-xs text-xs no-underline text-white transition-opacity duration-150 hover:opacity-100 focus-visible:outline-2 focus-visible:outline-[#d43458] focus-visible:outline-offset-3 motion-reduce:transition-none"
                    target="_blank"
                    rel="noreferrer noopener"
                    href={profile.linkedin}
                >
                    <Linkedin className="mx-auto w-8" />
                    LinkedIn
                </a>
            </li>
            <li class="flex flex-col gap-1.5 justify-center truncate text-xs opacity-50">
                <Folder className="mx-auto" />
                Play Data
            </li>
            <li class="flex flex-col gap-1.5 justify-center text-xs">
                <Bell className="mx-auto" />
                News
            </li>
        </ul>
    </nav>
    <div class="ml-4 w-[70vw] overflow-hidden whitespace-nowrap md:ml-0 sm:w-[45vw]">
        <p
            class="animate-marquee inline-block pl-[100%] text-cyan-300 motion-reduce:animate-none motion-reduce:pl-0"
            id="info"
            role="status"
        >
            Here you can find a summary of each section
        </p>
    </div>
    <Separator
        color="blue-300"
        orientation="horizontal"
        additionalClass="border-cyan-300 ml-4 md:ml-0 w-[70vw] sm:w-[45vw]"
        size={"[45vw]"}
    />
    <div class="flex mt-2.5 ml-0 text-white md:ml-0">
        <p class="flex items-center gap-1.5 text-xs">
            <XboxA className="mx-auto w-3.5" />
            <span class="h-min">Confirm</span>
        </p>
    </div>
</footer>

<script>
    import { currentTab } from "../store";
    import { defs, type IDefs } from "../global/constants";
    import getModalContent, { type TModalKey } from "../utils/getModalContent";

    const isDefKey = (name: TModalKey): name is keyof IDefs => name in defs;

    const render = (name: TModalKey) => {
        const info = document.getElementById("info");
        if (!info) return;
        // Learning keys are not in `defs`, so fall back to the section intro.
        const summary = isDefKey(name)
            ? defs[name]
            : getModalContent(name).intro;
        info.textContent = summary ? `${name} — ${summary}` : name;
    };

    // Text is swapped in place; restarting the marquee on every hover looked
    // broken because onmouseover fires on every move across the menu.
    currentTab.subscribe((value) => render(value.name));
    document.addEventListener("astro:page-load", () =>
        render(currentTab.get().name),
    );
</script>
