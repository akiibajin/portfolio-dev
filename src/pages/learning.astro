---
import DynamicMenu from "../components/svelte/DynamicMenu.svelte";
import type { TModalKey } from "../utils/getModalContent";
import Layout from "../layouts/Layout.astro";
import { learningSection } from "../global/constants";

const tabs: Array<{ name: TModalKey; path: string }> = (
  Object.keys(learningSection) as Array<keyof typeof learningSection>
).map((name) => ({
  name,
  path: `/learning#${name.toLowerCase()}`,
}));
---

<Layout title="Learning">
  <main class="lg:m-0! flex-1">
    <DynamicMenu tabs={tabs} mode="dialog" client:only="svelte" />
  </main>
</Layout>
