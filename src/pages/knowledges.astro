---
import DynamicMenu from "../components/svelte/DynamicMenu.svelte";
import type { TModalKey } from "../utils/getModalContent";
import Layout from "../layouts/Layout.astro";
const tabs: Array<{ name: TModalKey; path: string }> = [
  {
    name: "Frontend",
    path: "/knowledges/frontend",
  },
  {
    name: "Backend",
    path: "/knowledges/backend",
  },
  {
    name: "DevOps",
    path: "/knowledges/devops",
  },
  {
    name: "Methodologies",
    path: "/knowledges/methodologies",
  },
];
---

<Layout title="Knowledges">
  <main class="lg:m-0! flex-1">
    <DynamicMenu tabs={tabs} client:only="svelte" />
  </main>
</Layout>
