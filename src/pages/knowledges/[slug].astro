---
import Layout from "../../layouts/Layout.astro";
import CharacterSelect from "../../components/svelte/CharacterSelect.svelte";
import { knowledgeSection } from "../../global/constants";
import { slugify } from "../../utils/slugify";

export function getStaticPaths() {
    return (Object.keys(knowledgeSection) as Array<keyof typeof knowledgeSection>).map(
        (name, position) => ({
            params: { slug: slugify(name) },
            props: { name, position },
        })
    );
}

const { name, position } = Astro.props;
---

<Layout title={name}>
    <section class="lg:m-0! flex-1 w-full min-w-full max-w-none!">
        <CharacterSelect
            name={name}
            position={position}
            backPath="/knowledges"
            client:only="svelte"
        />
    </section>
</Layout>
