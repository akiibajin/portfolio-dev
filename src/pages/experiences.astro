---
import DynamicMenu from "../components/svelte/DynamicMenu.svelte";
import Layout from "../layouts/Layout.astro";
const tabs = [
  {
    name: "Professional Experience",
    path: "/experiences/professional-experience",
  },
  {
    name: "Personal Experience",
    path: "/experiences/personal-experience",
  },
  {
    name: "Freelance Experience",
    path: "/experiences/freelance-experience",
  },
  {
    name: "Certifications",
    path: "/experiences/certifications",
  },
];
---

<Layout title="Experience">
  <main class="lg:m-0! flex-1">
    <DynamicMenu tabs={tabs} client:only="svelte" />
  </main>
</Layout>
