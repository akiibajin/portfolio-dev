---
import DynamicMenu from "../components/svelte/DynamicMenu.svelte";
import type { TModalKey } from "../utils/getModalContent";
import Layout from "../layouts/Layout.astro";
import { experienceSection } from "../global/constants";
import { slugify } from "../utils/slugify";

const tabs: Array<{ name: TModalKey; path: string }> = (
  Object.keys(experienceSection) as Array<keyof typeof experienceSection>
).map((name) => ({
  name,
  path: `/experiences/${slugify(name)}`,
}));
---

<Layout title="Experience">
  <main class="lg:m-0! flex-1">
    <DynamicMenu tabs={tabs} client:only="svelte" />
  </main>
</Layout>
