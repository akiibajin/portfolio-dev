---
import Layout from "../../layouts/Layout.astro";
import CharacterSelect from "../../components/svelte/CharacterSelect.svelte";
import { experienceSection } from "../../global/constants";
import { slugify } from "../../utils/slugify";

export function getStaticPaths() {
    return (Object.keys(experienceSection) as Array<keyof typeof experienceSection>).map(
        (name, position) => ({
            params: { slug: slugify(name) },
            props: { name, position },
        })
    );
}

const { name, position } = Astro.props;
---

<Layout title={`${name} — Experience`}>
    <main class="m-0 w-full max-w-none overflow-visible p-0">
        <CharacterSelect
            name={name}
            position={position}
            backPath="/experiences"
            client:load
        />
    </main>
</Layout>
