---
import Layout from "../layouts/Layout.astro";
import { profile, coreStack } from "../global/constants";
---

<Layout title={`${profile.name} — ${profile.title}`}>
  <main class="mx-auto w-full max-w-[46rem] box-border px-5 pt-4 pb-12">
    <div
      class="rounded border border-[#3d4552] border-l-[3px] border-l-[#d43458] bg-[rgb(10_10_10/0.72)] p-[clamp(1.25rem,4vw,2.25rem)] shadow-[inset_0_0_60px_rgb(85_49_82/0.45)]"
    >
      <p class="m-0 mb-2 text-[0.7rem] uppercase tracking-[0.3em] text-[#8f98a6]">
        Player select · Ready
      </p>

      <h1
        class="m-0 text-[clamp(2.5rem,11vw,4.5rem)] font-medium uppercase leading-[0.95] tracking-[0.05em] text-white [text-shadow:0_0_18px_rgb(212_52_88/0.5),0_2px_0_rgb(85_49_82/0.9)]"
      >
        {profile.name}
      </h1>
      <p
        class="mt-1.5 mb-0 text-[clamp(1rem,4.5vw,1.5rem)] uppercase tracking-[0.2em] text-[#d43458]"
      >
        {profile.title}
      </p>

      <p
        class="mt-5 mb-0 max-w-[34rem] font-sans text-[clamp(0.95rem,2.6vw,1.05rem)] leading-[1.65] text-pretty text-[#dfe3ea]"
      >
        I build scalable web applications and intuitive user experiences,
        combining strong frontend expertise with backend development and modern
        software architecture.
      </p>

      <ul
        class="mt-6 mb-0 flex list-none flex-wrap gap-1.5 p-0"
        aria-label="Core technologies"
      >
        {
          coreStack.map((tech) => (
            <li
              class="rounded-[2px] border border-[rgb(212_52_88/0.55)] bg-[linear-gradient(to_bottom,rgb(85_49_82/0.9),rgb(43_26_41/0.9))] px-2.5 py-1 text-[0.75rem] uppercase tracking-[0.08em] text-[#f3e6ec]"
            >
              {tech}
            </li>
          ))
        }
      </ul>

      <div class="mt-7 mb-0 flex flex-wrap gap-3">
        <a
          href="/experiences"
          class="inline-flex items-center gap-2.5 rounded-[2px] border border-[#d43458] bg-[linear-gradient(to_right,#d43458,#553152)] px-4 py-2.5 text-lg uppercase tracking-[0.14em] text-white no-underline transition-shadow duration-150 hover:shadow-[0_0_12px_#d43458,0_0_28px_#553152] focus-visible:outline-2 focus-visible:outline-[#d43458] focus-visible:outline-offset-4 motion-reduce:transition-none"
        >
          <span
            class="grid h-[1.6rem] w-[1.6rem] place-items-center rounded-full bg-white text-[0.8rem] leading-none font-bold text-[#4a5565]"
            aria-hidden="true">A</span
          >
          <span>View My Projects</span>
        </a>
        <a
          href={profile.cv}
          download
          class="inline-flex items-center gap-2.5 rounded-[2px] border border-[#6b7482] bg-transparent px-4 py-2.5 text-lg uppercase tracking-[0.14em] text-white no-underline transition-[box-shadow,border-color,color] duration-150 hover:border-[#d43458] hover:text-[#f3e6ec] hover:shadow-[0_0_12px_rgb(85_49_82/0.9)] focus-visible:outline-2 focus-visible:outline-[#d43458] focus-visible:outline-offset-4 motion-reduce:transition-none"
        >
          <span
            class="grid h-[1.6rem] w-[1.6rem] place-items-center rounded-full bg-white text-[0.8rem] leading-none font-bold text-[#4a5565]"
            aria-hidden="true">Y</span
          >
          <span>Download CV</span>
        </a>
      </div>

      <p
        class="mt-6 mb-0 max-w-[34rem] font-sans text-[0.78rem] leading-[1.6] text-pretty text-[#aab2be] [&_kbd]:mx-[0.1rem] [&_kbd]:border [&_kbd]:border-[#3d4552] [&_kbd]:px-[0.3rem] [&_kbd]:py-[0.05rem] [&_kbd]:font-[inherit] [&_kbd]:text-[0.75rem] [&_kbd]:text-[#e8ecf2]"
      >
        This interface is a character select screen. Use <kbd>&larr;</kbd>
        <kbd>&rarr;</kbd> to move between fighters, <kbd>Enter</kbd> to confirm,
        and the shoulder buttons to switch sections.
      </p>

      <p
        class="mt-4 mb-0 border-t border-[#3d4552] pt-3.5 text-[0.75rem] uppercase tracking-[0.1em] text-[#8f98a6]"
      >
        Based in {profile.location} · {profile.languages}
      </p>
    </div>
  </main>
</Layout>
